# Public API base URL (used when mock mode is off)
NEXT_PUBLIC_HOST_API_KEY=https://assignment.devotel.io

# true = local fixtures (recommended for local demo)
# false = call remote API
# omit in development = mock on by default
NEXT_PUBLIC_USE_MOCK_API=true

# Login (see README "Auth & database")
# SQLite file used by Prisma; the Prisma CLI reads this from `.env`, not
# `.env.local`, so copy this file to `.env` (not just `.env.local`).
DATABASE_URL="file:./dev.db"
# Secret used to sign session JWTs — generate one with `npx auth secret`
# or `openssl rand -base64 32`.
AUTH_SECRET=
